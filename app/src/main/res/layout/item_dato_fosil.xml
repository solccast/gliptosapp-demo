<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#F9F5ED"
    app:strokeColor="#D4C5A9"
    app:strokeWidth="1dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ícono + etiqueta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iconoDato"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_3d" />

            <TextView
                android:id="@+id/etiquetaDato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Época"
                android:textAllCaps="true"
                android:textSize="11dp"
                android:textColor="@color/texto1" />
        </LinearLayout>

        <!-- Valor -->
        <TextView
            android:id="@+id/valorDato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pleistoceno"
            android:textStyle="bold"
            android:textSize="15dp"
            android:textColor="@color/texto1"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>