<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutPrincipalMapa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary">

    <!-- Botón Volver -->
    <ImageButton
        android:id="@+id/btnVolver"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_boton_ra"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Volver al menú anterior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btnAyuda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_help"
        android:background="@drawable/bg_boton_ra"
        android:contentDescription="Escuchar instrucciones del mapa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvInstruccionMapa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="Expedición: La Plata"
        android:textColor="#E8D7B0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:accessibilityHeading="true"
        app:layout_constraintStart_toEndOf="@id/btnVolver"
        app:layout_constraintEnd_toStartOf="@id/btnAyuda"
        app:layout_constraintTop_toTopOf="@id/btnVolver"
        app:layout_constraintBottom_toBottomOf="@id/btnVolver" />

    <!-- Mapa -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:contentDescription="Mapa de la ciudad de La Plata."
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- View transparente sobre el mapa, solo para TalkBack -->
    <View
        android:id="@+id/viewAccesibilidad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="yes"
        android:contentDescription="Terreno inexplorado. Deslizá el dedo para buscar fósiles."
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botones de zoom accesibles (esquina inferior derecha) -->
    <LinearLayout
        android:id="@+id/contenedorZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_chip_bloqueado"
            android:contentDescription="Acercar mapa"
            app:tint="@color/boton3"/>

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_remove"
            android:background="@drawable/bg_chip_bloqueado"
            android:contentDescription="Alejar mapa"
            app:tint="@color/boton3"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>