<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:rotation="-4"
        app:cardBackgroundColor="@color/post_its"
        app:strokeColor="@color/post_its"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:contentPadding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvMensajeAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/texto1"
                android:textSize="@dimen/texto_boton_medium"
                android:accessibilityLiveRegion="polite"
                android:text="Se ha informado al museo de posibles hallazgos de fósiles.\n\nSelecciona uno de los puntos para inspeccionar el área y comenzar la excavación" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntendido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="¡Entendido!"
                app:backgroundTint="@color/fondo1"
                android:textColor="@color/texto2"
                app:cornerRadius="10dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>