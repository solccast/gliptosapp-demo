<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary">

    <!-- Botón volver -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_boton_ra"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btnAyuda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_help"
        app:tint="@color/fondo1"
        android:background="@drawable/bg_boton_ra"
        android:contentDescription="Ayuda"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Personaje + globo de diálogo, ARRIBA de la card -->
    <LinearLayout
        android:id="@+id/contenedorKira"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/cardPregunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="500dp"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/ivPersonaje"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/kira"/>

        <TextView
            android:id="@+id/tvDialogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:padding="12dp"
            android:textSize="@dimen/texto_boton_medium"
            android:background="@drawable/bg_vinieta_redondeada"
            android:text="@string/como_jugar_minijuego"
            android:textColor="@color/texto1" />

    </LinearLayout>

    <!-- Card de la pregunta: wrap_content, debajo de Kira -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPregunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintWidth_max="500dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorKira"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="15dp">

            <TextView
                android:id="@+id/tvPregunta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pregunta_cual_es_mas_grande"
                android:textColor="@color/texto1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Opción A -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpcionA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/fondo_polaroid"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/fondo2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOpcionA"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/gliptodonte_sin_descubrir"
                            android:contentDescription="@string/opcion_camion" />

                        <TextView
                            android:id="@+id/tvOpcionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/opcion_camion"
                            android:textColor="@color/texto1"
                            android:textSize="@dimen/texto_boton_medium" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Opción B -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOpcionB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/fondo_polaroid"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/fondo2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/ivOpcionB"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/gliptodonte"
                            android:contentDescription="@string/opcion_fosil" />

                        <TextView
                            android:id="@+id/tvOpcionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/opcion_fosil"
                            android:textColor="@color/texto1"
                            android:textSize="@dimen/texto_boton_medium"  />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Botón "Ver información" (oculto hasta acertar) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerInformacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ver_informacion"
                android:visibility="gone"
                app:cornerRadius="24dp"
                android:textSize="@dimen/texto_boton_medium"
                app:backgroundTint="@color/boton_verde_claro" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>