<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary">

    <!-- Botón volver FUERA de la card -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_boton_ra"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btnAyuda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_help"
        app:tint="@color/fondo1"
        android:background="@drawable/bg_boton_ra"
        android:contentDescription="Ayuda"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Card cuaderno -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCuaderno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Perforaciones -->
            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:weightSum="18"
                android:importantForAccessibility="no">

                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Título -->
                        <TextView
                            android:id="@+id/tituloFosil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre fósil"
                            android:textSize="@dimen/texto_boton_large"
                            android:textStyle="bold"
                            android:focusable="true"
                            android:textColor="@color/texto1"
                            android:accessibilityHeading="true"
                            android:importantForAccessibility="yes"/>

                        <!-- Imagen con botón AR -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="12dp">

                            <ImageView
                                android:id="@+id/imagenFosil"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Imagen del fósil"
                                tools:background="@color/vinieta"
                                android:scaleType="centerInside"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVer"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/btn_ver_fosil_3d"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="2dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_3d"
                                app:iconGravity="textStart"
                                app:iconSize="25dp"
                                android:textSize="@dimen/texto_boton_medium"
                                app:iconPadding="5dp"
                                app:backgroundTint="@color/boton_verde_claro"
                                app:cornerRadius="24dp"
                                android:contentDescription="@string/btn_ver_fosil_3d"/>

                        </FrameLayout>

                        <!-- Descripción -->
                        <TextView
                            android:id="@+id/descripcionFosil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Descripción del fósil"
                            android:textColor="@color/texto1"
                            android:focusable="true"
                            android:layout_marginTop="12dp"/>

                        <!-- Nota de ¿sabias qué? -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#FFF9C4"
                            app:strokeColor="#E6D77E"
                            app:strokeWidth="1dp"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="6dp"
                            app:contentPadding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tituloNota"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sabias_que"
                                    android:textStyle="bold"
                                    android:textColor="#4B3621"
                                    android:focusable="true"/>

                                <TextView
                                    android:id="@+id/textoNota"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="#4B3621"
                                    android:lineSpacingExtra="4dp"
                                    android:focusable="true"
                                    android:text="@string/texto_ilegible_placeholder"/>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:id="@+id/contenedorInfoExtra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <!-- visible hasta ganar el minijuego (es el coso de Kira) -->
                            <FrameLayout
                                android:id="@+id/overlayBloqueo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">


                                <!-- Avatar + globo de diálogo -->
                                <LinearLayout
                                    android:id="@+id/contenedorKira"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="12dp"
                                    android:focusable="true"
                                    android:importantForAccessibility="yes">

                                    <ImageView
                                        android:id="@+id/imgKira"
                                        android:layout_width="100dp"
                                        android:layout_height="100dp"
                                        android:src="@drawable/kira"
                                        android:importantForAccessibility="no" />

                                    <TextView
                                        android:id="@+id/txtIndicacionKira"
                                        android:background="@drawable/bg_vinieta_redondeada"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:padding="15dp"
                                        android:layout_gravity="center_vertical"
                                        android:text="@string/mensaje_kira_minijuego"
                                        android:textColor="@color/texto1"
                                        android:textStyle="bold"
                                        android:accessibilityHeading="true" />
                                </LinearLayout>
                            </FrameLayout>

                            <!-- Visible cuando gana el minijuego -->
                            <LinearLayout
                                android:id="@+id/contenedorDatosFosil"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <!-- Fila 1: Época + Hábitat -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <include
                                        android:id="@+id/cardEpoca"
                                        layout="@layout/item_dato_fosil"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="6dp"/>

                                    <include
                                        android:id="@+id/cardHabitat"
                                        layout="@layout/item_dato_fosil"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="6dp"/>
                                </LinearLayout>

                                <!-- Fila 2: Tamaño + Peso -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="10dp">

                                    <include
                                        android:id="@+id/cardTamano"
                                        layout="@layout/item_dato_fosil"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="6dp"/>

                                    <include
                                        android:id="@+id/cardPeso"
                                        layout="@layout/item_dato_fosil"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="6dp"/>
                                </LinearLayout>

                                <!-- Fila 3: Dieta (ancho completo) -->
                                <include
                                    android:id="@+id/cardDieta"
                                    layout="@layout/item_dato_fosil"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"/>

                            </LinearLayout>
                        </FrameLayout>

                    </LinearLayout>
                </ScrollView>

                <!-- Botón Jugar FUERA del scroll, pegado al fondo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/jugar"
                    android:textSize="@dimen/texto_boton_medium"
                    android:textAllCaps="false"
                    app:backgroundTint="?attr/colorAppButtonSecondary"
                    app:icon="@drawable/gamepad_2"
                    app:iconSize="25dp"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>