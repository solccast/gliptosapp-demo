<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary"
    tools:context=".ui.excavation.ExcavacionActivity">

    <!-- IMAGEN DE FONDO -->
    <ImageView
        android:id="@+id/imgFosilFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/gliptodonte_1"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ÁREA INTERACTIVA -->
    <View
        android:id="@+id/areaExcavacionClick"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="Zona de excavación. Selecciona la herramienta correcta para desenterrar el fósil."
        app:layout_constraintTop_toBottomOf="@id/contenedorBotonesSuperiores"
        app:layout_constraintBottom_toTopOf="@id/contenedorHerramientas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FILA SUPERIOR: Botón volver + Botones info/config -->
    <LinearLayout
        android:id="@+id/contenedorBotonesSuperiores"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Volver (izquierda) -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_boton_ra"
            android:contentDescription="Volver" />

        <!-- Spacer para empujar info/config a la derecha -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Botón Info -->
        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_help"
            android:background="@drawable/bg_boton_ra"
            android:contentDescription="Información"
            android:layout_marginEnd="8dp" />


    </LinearLayout>

    <!-- AVATAR KIRA -->
    <LinearLayout
        android:id="@+id/contenedorKira"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_vinieta_redondeada"
        android:focusable="true"
        android:clickable="false"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/contenedorBotonesSuperiores"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgKira"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/kira"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtIndicacionKira"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:text="¡Hola! Vamos a excavar. Primero, seleccioná el Pico para romper la tierra dura."
            android:textColor="@color/texto1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <!-- CONTENEDOR DE HERRAMIENTAS -->
    <LinearLayout
        android:id="@+id/contenedorHerramientas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:weightSum="3"
        android:background="@drawable/bg_contenedor_herramientas"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnPicoContenedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@color/selector_fondo_herramienta"
            android:contentDescription="Herramienta Pico">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pico"
                app:tint="@color/selector_icono_herramienta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pico"
                android:textColor="@color/selector_icono_herramienta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPalaContenedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@color/selector_fondo_herramienta"
            android:contentDescription="Herramienta Pala">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pala"
                app:tint="@color/selector_icono_herramienta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pala"
                android:textColor="@color/selector_icono_herramienta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPincelContenedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@color/selector_fondo_herramienta"
            android:contentDescription="Herramienta Pincel">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_pincel"
                app:tint="@color/selector_icono_herramienta"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pincel"
                android:textColor="@color/selector_icono_herramienta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>