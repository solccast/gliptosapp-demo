<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary"
    tools:context=".ui.home.InitFragment">

    <ImageView
        android:id="@+id/imgPatitasBottom"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:src="@drawable/patitas"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/btnInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:tint="@color/fondo1"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_help"
        android:background="@drawable/bg_boton_ra"
        android:contentDescription="Más información"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCuaderno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="96dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintTop_toBottomOf="@id/btnInfo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:weightSum="18"
                android:importantForAccessibility="no"
                tools:ignore="DisableAccessibility">

                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
            </LinearLayout>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp">

                    <LinearLayout
                        android:id="@+id/contenedorCabecera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:focusable="true"
                        android:clickable="false"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caminando sobre\nGliptodontes"
                            android:textAlignment="center"
                            android:textColor="@color/texto1"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:accessibilityHeading="true"/>

                        <TextView
                            android:id="@+id/txtSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Descubrí los gigantes que habitaron\nLa Plata hace miles de años"
                            android:textAlignment="center"
                            android:textColor="@color/boton2"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExcavacion"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/boton1"
                        android:text="@string/excavacion"
                        android:textColor="@color/texto3"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Comenzar excavación para descubrir fósiles"
                        app:icon="@drawable/ic_pala"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/texto3"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnColeccion"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/boton2"
                        android:text="@string/coleccion_fosiles"
                        android:textColor="@color/texto3"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Ver mi colección de fósiles guardados"
                        app:icon="@drawable/ic_coleccion"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/texto3"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings"
                        android:backgroundTint="@color/post_its"
                        android:textColor="@color/texto3"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Abrir opciones y ajustes de la aplicación"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/texto3"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecursos"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="12dp"
                        android:textSize="@dimen/texto_boton_medium"
                        android:text="@string/recursos"
                        android:textColor="@color/texto3"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="@color/boton_recursos_azul"
                        android:contentDescription="@string/recursos"
                        app:icon="@drawable/ic_libro"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/texto3"
                        app:iconSize="24dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>