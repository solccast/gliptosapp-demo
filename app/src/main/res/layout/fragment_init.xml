<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo1"
    tools:context=".ui.home.InitFragment">

    <ImageView
        android:id="@+id/imgPatitasTop"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/patitas"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCuaderno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintTop_toBottomOf="@id/imgPatitasTop"
        app:layout_constraintBottom_toTopOf="@id/imgPatitasBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Perforaciones del cuaderno (Decorativo) -->
            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:weightSum="18"
                android:importantForAccessibility="no"
                tools:ignore="DisableAccessibility">

                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
            </LinearLayout>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                      <LinearLayout
                        android:id="@+id/contenedorCabecera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:focusable="true"
                        android:clickable="false"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/txtTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caminando sobre\nGliptodontes"
                            android:textAlignment="center"
                            android:textColor="@color/texto1"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:accessibilityHeading="true"/>

                        <TextView
                            android:id="@+id/txtSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Descubrí los gigantes que habitaron\nLa Plata hace miles de años"
                            android:textAlignment="center"
                            android:textColor="@color/boton2"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <!-- ACCIONES INTERACTIVAS -->
                    <Button
                        android:id="@+id/btnExcavacion"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/boton1"
                        android:text="@string/excavacion"
                        android:textColor="@color/texto2"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Comenzar excavación para descubrir fósiles"/>

                    <Button
                        android:id="@+id/btnColeccion"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/boton2"
                        android:text="@string/coleccion_fosiles"
                        android:textColor="@color/texto2"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Ver mi colección de fósiles guardados"/>

                    <Button
                        android:id="@+id/btnAjustes"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/post_its"
                        android:text="@string/settings"
                        android:textColor="@color/texto1"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_boton_medium"
                        android:contentDescription="Abrir opciones y ajustes de la aplicación"/>

                    <Button
                        android:id="@+id/btnRecursos"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/boton_alto_medium"
                        android:layout_marginTop="16dp"
                        android:textSize="@dimen/texto_boton_medium"
                        android:text="@string/recursos"
                        android:textColor="@color/texto2"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="@color/boton_recursos_azul"
                        android:contentDescription="@string/recursos"/>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/imgPatitasBottom"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:src="@drawable/patitas"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>