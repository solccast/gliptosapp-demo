<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary">

    <!-- Botón volver FUERA de la card -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_boton_ra"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Card cuaderno -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCuaderno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Perforaciones -->
            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:weightSum="18"
                android:importantForAccessibility="no">

                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />
                <ImageView android:layout_width="14dp" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/perforacion_hoja" android:scaleType="center" android:importantForAccessibility="no" />

            </LinearLayout>

            <!-- Contenido -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Título -->
                <TextView
                    android:id="@+id/titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/coleccion_fosiles"
                    android:textSize="@dimen/texto_boton_large"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAppText"
                    android:padding="16dp"
                    android:accessibilityHeading="true"/>

                <!-- Lista -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaFosiles"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"
                    app:spanCount="2"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_fosil_desc"
                    android:contentDescription="@string/coleccion_lista"/>

                <!-- Botón Ir al mapa pegado al fondo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/ir_al_mapa"
                    app:backgroundTint="@color/boton_verde_claro"
                    app:icon="@drawable/ic_map"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>