<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="?attr/colorAppPrimary"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/colorAppPrimary">
        <include
            android:id="@+id/backButton"
            layout="@layout/view_back_button"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/settings"
            android:accessibilityHeading="true"
            android:textSize="32sp"
            android:textColor="?attr/colorAppText"
            android:textStyle="bold"/>
        <!-- MODO DE INTERACCIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvInteractionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de interacción"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:accessibilityHeading="true"/>

                <!-- OPCIÓN ARRASTRAR -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDragMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="2dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <!-- Indicador -->

                        <View
                            android:id="@+id/indicatorDragMode"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_circle_indicator"/>

                        <!-- Texto -->

                        <TextView
                            android:id="@+id/tvDragMode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Arrastrar piezas"/>

                        <!-- Mano -->
                        <ImageView
                            android:id="@+id/imgDragHand"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_touch_destination"/>

                        <ImageView
                            android:id="@+id/imgArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_arrow_back"/>

                        <!-- Pieza -->

                        <ImageView
                            android:id="@+id/imgPiece"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_touch_piece"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- OPCIÓN TOCAR -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTapMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <View
                            android:id="@+id/indicatorTapMode"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_circle_indicator"/>

                        <TextView
                            android:id="@+id/tvTapMode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Tocar pieza y destino"/>

                        <ImageView
                            android:id="@+id/imgTouchPiece"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_touch_piece"/>

                        <ImageView
                            android:id="@+id/imgTouchDestination"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_touch_destination"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- APOYO VISUAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:screenReaderFocusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soporte visual"
                    android:textStyle="bold"
                    android:accessibilityHeading="true"/>

                <!-- Alto contraste -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContrast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/switchContrast"
                        android:text="Alto contraste"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchContrast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Soporte visual. Activa colores de alto contraste para mejorar la visibilidad"/>
                </LinearLayout>

                <!-- Tamaño de texto -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tamaño de texto"/>

                    <LinearLayout
                        android:id="@+id/fontSizeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardFontSmall"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"
                            android:contentDescription="Soporte visual. Tamaño de texto pequeño">

                            <TextView
                                android:id="@+id/tvFontSmall"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="A"
                                android:textSize="14sp"
                                android:importantForAccessibility="no"/>

                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardFontMedium"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"

                            android:contentDescription="Soporte visual. Tamaño de texto mediano">

                            <TextView
                                android:id="@+id/tvFontMedium"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="A"
                                android:textSize="18sp"
                                android:importantForAccessibility="no"/>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardFontLarge"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"
                            android:contentDescription="Soporte visual. Tamaño de texto grande">
                            <TextView
                                android:id="@+id/tvFontLarge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="A"
                                android:textSize="22sp"
                                android:importantForAccessibility="no"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDyslexiaFont"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Letra dislexia"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDyslexiaFont"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Soporte visual. Activar tipografía para personas con dislexia"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- APOYO AUDITIVO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apoyo auditivo"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <!-- Narración -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Narración" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNarration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Apoyo auditivo. Activar narración de instrucciones y eventos" />

                </LinearLayout>

                <!-- Sonidos -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sonidos" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSounds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Apoyo auditivo. Activar efectos de sonido" />

                </LinearLayout>

                <!-- Vibración -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vibración" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Apoyo auditivo. Activar vibración como retroalimentación" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>