<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppPrimary">

    <ImageView
        android:id="@+id/imgPatitasBottom"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:src="@drawable/patitas"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Segunda columna: btnInfo arriba a la derecha -->
    <ImageButton
        android:id="@+id/btnInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:tint="@color/fondo1"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_help"
        android:background="@drawable/bg_boton_ra"
        android:contentDescription="Más información"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Primera columna: CardView anclada a la izquierda y a la derecha del btnInfo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCuaderno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="42dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/vinieta"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnInfo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginBottom="16dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/perforacion_hoja" android:importantForAccessibility="no"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="24dp">

                    <LinearLayout
                        android:id="@+id/contenedorCabecera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/txtTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caminando sobre Gliptodontes"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:textColor="@color/texto1"
                            android:accessibilityHeading="true"/>

                        <TextView
                            android:id="@+id/txtSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Descubrí los gigantes que habitaron La Plata"
                            android:textSize="14sp"
                            android:textColor="@color/boton2"/>
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="true">

                        <Button
                            android:id="@+id/btnExcavacion"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/boton_alto_medium"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:text="@string/excavacion"
                            android:backgroundTint="@color/boton1"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:textSize="@dimen/texto_boton_medium"
                            android:contentDescription="Comenzar excavación para descubrir fósiles"/>

                        <Button
                            android:id="@+id/btnColeccion"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/boton_alto_medium"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:text="@string/coleccion_fosiles"
                            android:backgroundTint="@color/boton2"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:textSize="@dimen/texto_boton_medium"
                            android:contentDescription="Ver mi colección de fósiles guardados"/>

                        <Button
                            android:id="@+id/btnAjustes"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/boton_alto_medium"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:text="@string/settings"
                            android:backgroundTint="@color/post_its"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:textSize="@dimen/texto_boton_medium"
                            android:contentDescription="Abrir opciones y ajustes de la aplicación"/>

                        <Button
                            android:id="@+id/btnRecursos"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/boton_alto_medium"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:text="@string/recursos"
                            android:textColor="@color/texto2"
                            android:backgroundTint="@color/boton_recursos_azul"
                            android:textAllCaps="false"
                            android:textSize="@dimen/texto_boton_medium"
                            android:contentDescription="@string/recursos"/>

                    </GridLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>